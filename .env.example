# Environment variables for fruit-recognition project
# Copy this file to .env and adjust values as needed

# Model settings
MODEL_PATH=models/best_model.pt
CLASS_NAMES_PATH=models/class_names.json

# Data settings
DATA_DIR=data
BATCH_SIZE=32
IMAGE_SIZE=224

# Training settings
EPOCHS=50
LEARNING_RATE=0.001
DEVICE=cuda

# API/Server settings
HOST=0.0.0.0
PORT=8501
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO